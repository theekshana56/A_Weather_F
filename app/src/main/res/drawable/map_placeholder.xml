<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base map background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8F4FD" />
        </shape>
    </item>

    <!-- Grid pattern overlay to simulate map -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#D0E7F7"
                android:dashWidth="10dp"
                android:dashGap="10dp" />
        </shape>
    </item>

    <!-- Simulated radar data circles -->
    <item android:top="60dp" android:left="80dp">
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="#4CAF50" />
            <stroke android:width="2dp" android:color="#388E3C" />
        </shape>
    </item>

    <item android:top="120dp" android:left="150dp">
        <shape android:shape="oval">
            <size android:width="30dp" android:height="30dp" />
            <solid android:color="#FFC107" />
            <stroke android:width="2dp" android:color="#FF8F00" />
        </shape>
    </item>

    <item android:top="90dp" android:left="200dp">
        <shape android:shape="oval">
            <size android:width="25dp" android:height="25dp" />
            <solid android:color="#FF5722" />
            <stroke android:width="2dp" android:color="#D84315" />
        </shape>
    </item>

    <!-- Map border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#B3D9F7" />
        </shape>
    </item>

    <!-- Center crosshair -->
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="20dp" android:height="2dp" />
            <solid android:color="#666666" />
        </shape>
    </item>

    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="20dp" />
            <solid android:color="#666666" />
        </shape>
    </item>

</layer-list>